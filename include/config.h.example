#pragma once

// Microsoft Entra Tenant ID and Client ID are configured and saved from the device web page.

// Supported 3-channel addressable LEDs: WS2812B or SK6812 RGB.
// SK6812 RGBW requires a dedicated 4-channel output configuration.
#define LED_CHIPSET WS2812B
#define LED_PIN 18
#define LED_COUNT 8
#define LED_BRIGHTNESS 80

// Microsoft Graph polling interval
#define PRESENCE_POLL_MS 60000UL

// Local configuration web server
#define WEB_PORT 80
